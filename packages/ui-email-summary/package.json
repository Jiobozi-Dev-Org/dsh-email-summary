{
  "name": "@jiobozi-dev-org/dsh-client-ui-email-summary",
  "description": "Email-summary settings page, per-message send button, and composer auto-send toggle for the DeepSeek Harness (Client half).",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jiobozi-Dev-Org/dsh-email-summary.git",
    "directory": "packages/ui-email-summary"
  },
  "homepage": "https://github.com/Jiobozi-Dev-Org/dsh-email-summary#readme",
  "bugs": {
    "url": "https://github.com/Jiobozi-Dev-Org/dsh-email-summary/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "src"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.0.1-rc.1",
    "@jiobozi-dev-org/dsh-email-summary": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
